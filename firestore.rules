rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gdyounus2025@gmail.com' ||
        (request.auth.token.email_verified == true)
      );
    }

    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.category is string && data.category.size() <= 50
        && data.description is string && data.description.size() <= 3000
        && data.client is string && data.client.size() <= 100
        && data.year is string && data.year.size() <= 20;
    }

    function isValidProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 120
        && data.title is string && data.title.size() <= 150;
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 120
        && data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    // Projects: publicly visible, manageable by authenticated owner/admin
    match /projects/{projectId} {
      allow read, get, list: if true;
      allow create: if isOwnerOrAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOwnerOrAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isOwnerOrAdmin() && isValidId(projectId);
    }

    // Profile: publicly visible, editable by authenticated owner/admin
    match /profile/{profileId} {
      allow read, get, list: if true;
      allow create, update: if isOwnerOrAdmin() && isValidId(profileId) && isValidProfile(incoming());
    }

    // Dynamic Content (Skills, Experience, Education)
    match /content/{contentId} {
      allow read, get, list: if true;
      allow create, update, delete: if isOwnerOrAdmin() && isValidId(contentId);
    }

    // Settings (Admin password configuration)
    match /settings/{settingId} {
      allow read, get: if true;
      allow create, update: if isOwnerOrAdmin() && isValidId(settingId);
    }

    // Contact Inquiries: can be sent by visitors, viewed by owner
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow read, delete: if isOwnerOrAdmin() && isValidId(messageId);
    }

    // Connectivity probe
    match /test/{docId} {
      allow read: if true;
    }
  }
}
